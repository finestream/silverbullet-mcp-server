{
  "name": "silverbullet-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "An MCP server for a SilverBullet instance in multi-space mode: per-user credentials, an access list, a write filter and a scan that keep code out of the pages agents write, and pages rendered through the Runtime API.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "scan": "node src/main.ts --scan",
    "lint": "eslint . && tsc -p tsconfig.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test 'src/**/*.test.ts'",
    "test:integration": "node --test --test-concurrency=1 'test/server/*.test.ts'",
    "test:release": "node test/run.ts",
    "bootstrap": "node test/bootstrap.ts"
  },
  "dependencies": {
    "@lezer/common": "1.5.2",
    "@lezer/lr": "1.4.10",
    "@lezer/markdown": "1.7.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0"
  },
  "optionalDependencies": {
    "playwright": "^1.64.1"
  }
}
